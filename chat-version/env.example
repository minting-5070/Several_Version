# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# SerpAPI Configuration
# Get your API key from: https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here

# Example: OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Example: SERPAPI_KEY=10a7eecd364342e3d78c4e2c184b21fa7b2d214d49c89cd01c6435362aee9106

# Paper database quality (experiment factor): 'high' or 'low'
# Selects which DB file is used (raw-high.ts vs raw-low.ts) AND tags logs with -high/-low.
# Defaults to 'high' when unset. NEXT_PUBLIC_ vars are inlined at BUILD time,
# so set this per deployment/build (one build for high, one for low).
NEXT_PUBLIC_PAPER_DB=high
